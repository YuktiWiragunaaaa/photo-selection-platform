# ============================================================
# Photo Selection Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# ADMIN AUTH
# ------------------------------------------------------------
# Password to access the admin dashboard
ADMIN_PASSWORD=changeme123

# Secret key for JWT signing — generate a strong random string!
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Token expiry in minutes (default: 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# SQLite (recommended for local development)
DATABASE_URL=sqlite:///./photo_platform.db

# PostgreSQL (recommended for production / Railway / Render)
# DATABASE_URL=postgresql://user:password@localhost:5432/photo_platform

# ------------------------------------------------------------
# GOOGLE DRIVE SERVICE ACCOUNT
# ------------------------------------------------------------
# Path to your Service Account JSON key file
# See README.md for step-by-step instructions to create this
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ------------------------------------------------------------
# CORS / APP URLS
# ------------------------------------------------------------
# URL of your frontend (used for CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Base URL of this backend (used to generate gallery links)
BASE_URL=http://localhost:8000

# Environment: development | production
APP_ENV=development
